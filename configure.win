#!/usr/bin/env sh
# pdfium R package — Windows configure script.
#
# Selects a libpdfium to build against in this order:
#   1. PDFIUM_HOME env var pointing at an existing install
#      (with include/fpdfview.h, lib/libpdfium.dll.a, and
#      bin/libpdfium.dll already in Mingw-compatible form)
#   2. Fall back to downloading the pinned bblanchon binary via
#      tools/download-pdfium.R (the existing behavior, which also
#      regenerates a Mingw import library from the MSVC tarball).
#
# Windows has no canonical system pdfium install location, so we
# only consult PDFIUM_HOME explicitly — guessing system paths
# would risk picking up a stray DLL the user did not intend.
#
# When PDFIUM_HOME is honored, its files are staged into
# inst/{include,lib,bin}/ so the rest of the build pipeline (and
# src/install.libs.R) sees the same layout regardless of source.

set -eu
PKG_ROOT="$(cd "$(dirname "$0")" && pwd)"
RSCRIPT="${R_HOME}/bin/Rscript.exe"

USE_SYSTEM=""
if [ -n "${PDFIUM_HOME:-}" ]; then
  if [ -f "$PDFIUM_HOME/include/fpdfview.h" ] && \
     [ -f "$PDFIUM_HOME/lib/libpdfium.dll.a" ] && \
     [ -f "$PDFIUM_HOME/bin/libpdfium.dll" ]; then
    USE_SYSTEM=1
  else
    echo "[pdfium configure.win] PDFIUM_HOME=$PDFIUM_HOME set but" \
         "missing one of include/fpdfview.h, lib/libpdfium.dll.a," \
         "bin/libpdfium.dll; falling back to download." >&2
  fi
fi

if [ -n "$USE_SYSTEM" ]; then
  echo "[pdfium configure.win] Staging libpdfium from PDFIUM_HOME=$PDFIUM_HOME"
  mkdir -p "$PKG_ROOT/inst/include" "$PKG_ROOT/inst/lib" "$PKG_ROOT/inst/bin"
  cp -R "$PDFIUM_HOME/include/." "$PKG_ROOT/inst/include/"
  cp    "$PDFIUM_HOME/lib/libpdfium.dll.a" "$PKG_ROOT/inst/lib/"
  cp    "$PDFIUM_HOME/bin/libpdfium.dll"   "$PKG_ROOT/inst/bin/"
else
  echo "[pdfium configure.win] No system libpdfium found; downloading binary for Windows"
  "$RSCRIPT" --vanilla "$PKG_ROOT/tools/download-pdfium.R" "$PKG_ROOT"
fi
echo "[pdfium configure.win] inst/{include,lib,bin} populated."
